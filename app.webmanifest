{
  "name": "Kepler Finish Estimator",
  "short_name": "Kepler ETA",
  "description": "When will they finish the Kepler Challenge or Luxmore Grunt?",
  "id": "./index.html",
  "start_url": "./index.html?app",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f5f6f4",
  "theme_color": "#f5f6f4",
  "icons": [
    { "src": "icons/kepler-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/kepler-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/kepler-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/kepler-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Kepler Challenge 60 km", "short_name": "Kepler", "url": "./index.html",
      "icons": [{ "src": "icons/kepler-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Luxmore Grunt 27 km", "short_name": "Grunt", "url": "./grunt.html",
      "icons": [{ "src": "icons/grunt-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
